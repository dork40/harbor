<?xml version="1.0" encoding="utf-8"?>
<!-- NAS apps are served over plain HTTP on the home network / tailnet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
